# ---- Database ----
# Local demo default: SQLite file. For Supabase/Postgres set e.g.
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/postgres
DATABASE_URL=sqlite:///./disaster.db

# ---- API / CORS ----
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-vercel-app.vercel.app

# ---- Moderator / admin (demo-only protection, see PRD Q6) ----
ADMIN_SECRET=sih-demo-admin-secret

# ---- Ingestion ----
ENABLE_SCHEDULER=true
WEATHER_REFRESH_MINUTES=10
EARTHQUAKE_REFRESH_MINUTES=10
DETECTION_INTERVAL_MINUTES=5
MOCK_FALLBACK=false

# ---- Detection thresholds (config-driven rules) ----
QUAKE_PUBLIC_THRESHOLD=3.0
RAIN_HEAVY_MM_24H=64.5
RAIN_VERY_HEAVY_MM_24H=115.6
RAIN_EXTREME_MM_24H=204.5
HEATWAVE_TEMP_C=40.0
CLUSTER_RADIUS_KM=50.0
STALE_WEATHER_HOURS=2.0

# Community verification: upvotes needed to auto-verify a citizen report
REPORT_VERIFY_UPVOTES=10
